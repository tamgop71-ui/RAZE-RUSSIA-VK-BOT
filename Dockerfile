📚 RAZE RUSSIA | КОМАНДЫ БОТА

🤖 Введите команду с !, /, . или #

━━━━━━━━━━━━━━━━━━
👤 ОБЩИЕ
━━━━━━━━━━━━━━━━━━
!пинг — проверить работу бота
!правила — правила беседы
!роли — роли и приоритеты
!админы — список администрации
!онлайн — онлайн участников
!myid — ваш VK ID
!id — ID беседы
!профиль [ID] — профиль пользователя
/report [текст] — отправить репорт
!команды — открыть меню команд

━━━━━━━━━━━━━━━━━━
🛡 МОДЕРАЦИЯ
━━━━━━━━━━━━━━━━━━
!сник [ID] [ник] — назначить ник
!рник [ID] — снять ник
!мут [ID] [мин] [причина]
!унмут [ID]
!кик [ID] [причина]
!пред [ID] [причина]
!унварн [ID]
!предупреждения [ID]
!бан [ID] [дни] [причина]
!унбан [ID]

━━━━━━━━━━━━━━━━━━
👑 АДМИНИСТРАЦИЯ
━━━━━━━━━━━━━━━━━━
40+ !role [ID] [роль/приоритет]
40+ !removerole [ID]
40+ !модер [ID]
40+ !помощник [ID]
60+ !grole / !gban / !gunban
60+ !удалить
80+ !pin / !unpin
80+ !admin / !gadmin
80+ !setrules / !welcome
100+ !setup / !sync / !owner / !automod
100+ !unity / !createunity / !listunities

