# VK community token with access to messages and conversation management
VK_TOKEN=PUT_COMMUNITY_TOKEN_HERE
# Numeric community ID without minus sign
VK_GROUP_ID=123456789
# Your VK numeric user ID(s), comma-separated. These IDs are bot owners.
OWNER_IDS=12345678
VK_API_VERSION=5.199
TZ=Europe/Moscow
DB_PATH=/app/data/raze.sqlite
LONGPOLL_WAIT=25
